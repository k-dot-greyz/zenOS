{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template Registry Entry",
  "type": "object",
  "required": ["id", "name", "path", "type", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "version": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "epic", "legendary"]
    },
    "discovery": {
      "type": "object"
    },
    "usage": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "evolution": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
