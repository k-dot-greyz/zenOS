# zenOS env template v1.0
# Copy to .env (gitignored) or run: python scripts/setup_env.py
#
# Startup requirements (not env vars — zen/Cloud Agent start will fail without them):
#   - Python 3.14+ (zen.runtime.MIN_PYTHON)
#   - Current stables from pyproject.toml / requirements.txt
#   - bash scripts/zenos-env-install.sh
#   - bash scripts/zenos-env-start.sh
#   - zen env-doctor --format json
#
# Never put real tokens in this file. Map the same keys to GitHub Actions
# secrets for CI parity (GITHUB_TOKEN is provided by Actions automatically).

# GitHub MCP / API
# PAT name: zenos-mcp-<env>-YYYY-MM  (example: zenos-mcp-cursor-2026-09)
# Minimum scopes: repo + read:org. Add workflow / security_events / project as needed.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_EMAIL=
GITHUB_ORG=

# OpenRouter / model routing
OPENROUTER_API_KEY=

# zenOS engine — product | persona | investment
ZEN_ENGINE_MODE=product

# MCP remote endpoint override (optional)
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# OAuth path (optional — public client id only, never a client secret here)
GITHUB_OAUTH_CLIENT_ID=
