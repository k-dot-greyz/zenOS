# zenOS Environment Configuration
# Copy this file to .env once. Identity, fork URL, and API keys all live here.
#
# Startup requirements (not env vars — zen/Cloud Agent start will fail without them):
#   - Python 3.14+ (zen.runtime.MIN_PYTHON)
#   - Current stables from pyproject.toml / requirements.txt
#   - bash scripts/zenos-env-install.sh   # uv CPython 3.14 venv + pip -e ".[dev]"
#   - bash scripts/zenos-env-start.sh     # Cloud Agent / local per-boot gate
#   - zen env-doctor
#
# If you skip ZENOS_GITHUB_OWNER / ZENOS_REPO_URL, zenOS reads
# `git remote get-url origin` from this checkout.

# --- Identity / origin (set once after you fork) ---
ZENOS_GITHUB_OWNER=
ZENOS_REPO_NAME=zenOS
ZENOS_REPO_URL=
ZENOS_REPO_BRANCH=main
ZENOS_HTTP_REFERER=https://zenos.ai
ZENOS_PRIVATE_REPO=

# --- Secrets ---
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# GitHub (clone_all_repos / private remotes)
GITHUB_TOKEN=

# --- Database (optional - defaults shown) ---
DB_PASSWORD=zenpass
ZEN_DB_URL=postgresql://zen:zenpass@zen-memory:5432/zenos
REDIS_URL=redis://zen-cache:6379

# --- Model ---
ZEN_DEFAULT_MODEL=anthropic/claude-3-sonnet
ZEN_MAX_TOKENS=2000
ZEN_TEMPERATURE=0.7

# --- Behavior ---
ZEN_AUTO_CRITIQUE=true
ZEN_STREAM=true
ZEN_DEBUG=false

# --- Cost ---
ZEN_MAX_COST_PER_REQUEST=1.0
